			// Block URL patterns
			if (BLOCKED_URL_PATTERNS.some(pattern =>
				href.includes(pattern.toLowerCase())
			)) {
				return true;
			}

			// Block domains
			return BLOCKED_DOMAINS.some(domain =>
				hostname === domain ||
				hostname.endsWith('.' + domain)
			);
		} catch (e) {
			return false;
		}
	}

	function blockScript(node, method) {
		if (!isBlockedScript(node)) {
			return false;
