function collectAdSize(params) {
	
	if (window.a360_ad_size_recorded && window.a360_ad_size_recorded[params.slotId]) {
		console.log('ADH','slot '+params.slotId+' already logged, skipping');
		return;
	}
	
	window.a360_ad_size_recorded
	
	if (!window.a360_ad_size_recorded) window.a360_ad_size_recorded={};
	
	window.a360_ad_size_recorded[params.slotId] = true;
	
	return new Promise(function(resolve, reject) {
		if (typeof params !== 'object' || params === null) {
			reject('Invalid params');
			return;
		}

		var xhr = new XMLHttpRequest();

		xhr.onreadystatechange = function() {
			if (xhr.readyState !== XMLHttpRequest.DONE) {
				return;
			}

			if (xhr.status === 200) {
				console.log(
					'ADH XHR HTTP[200]',
					'[' + xhr.status + ']',
					'[' + xhr.statusText + ']'
				);
				resolve(xhr.responseText);
			} else {
				console.log(
					'ADH XHR HTTP[non-200]',
					'[' + xhr.status + ']',
					'[' + xhr.statusText + ']'
				);
				reject(
					'Call failed with [' +
					xhr.status +
					'] [' +
					xhr.statusText +
					']'
				);
			}
		};

		xhr.open('POST', '/wp-json/ad/v1/collect-size', true);
		xhr.setRequestHeader('Content-Type', 'application/json');

		console.log('ADH', '[adInfo] sending', params);

		try {
			xhr.send(JSON.stringify(params));
		} catch (err) {
			reject(err);
		}
	});
}

function waitForFinalHeightFromDirectTag({
  stableForMs = 1000,//how long the height must stay unchanged to be considered “final”
  timeoutMs = 5000 //hard stop to avoid hanging forever
} = {}) {
  return new Promise(resolve => {
    let lastHeight = null; //remembers last measured height
    let stableTimer = null; //countdown until we consider height “final”
    let resolved = false; //prevents resolving Promise twice
    let resizeObserver = null; //watches height changes
    let mutationObserver = null; //watches DOM for element appearance

    //resolve safely 
    //If height is null, we return 0.
    function finish(height) { 
      if (resolved) {
	    console.log('ADH finish 0');
		return;	
	  }
      resolved = true;
      resizeObserver?.disconnect();
      mutationObserver?.disconnect();
      console.log('ADH finish X '+(height ?? 0));
      resolve(height ?? 0);
    }

    function observe(el) { //watch height changes
      resizeObserver = new ResizeObserver(entries => {
        const height = Math.round(entries[0].contentRect.height);

        if (height !== lastHeight) {
	      console.log('ADH height changed from '+lastHeight+' to '+height);
          lastHeight = height;
          clearTimeout(stableTimer);
          
          //if no changes in height happened for stableForMs ms (1sec now)
          //we consider it the 'final' height and finish
          //until then we constanly "reset" the stableForMs "countdown"
          stableTimer = setTimeout(() => finish(height), stableForMs);
        }
      });

      resizeObserver.observe(el);
    }

    function tryFindTarget() {//get the dfp div containig ad iframe
      const directTag = document.getElementById("directTag");
      if (!directTag) {
	    console.log('ADH no directTag div - should never happen');
		return false;
	  }

      const firstDiv = directTag.querySelector(":scope > div");
      if (!firstDiv) {
		console.log('ADH no inner div yet within the directTag ');	
		return false;
	  }

      observe(firstDiv);
      return true;
    }

     //try to find the dfp div/iframe synchonously
    if (tryFindTarget()) {
        console.log('ADH found dfp div/iframe synchonously ');	
		return;
	}

    //try to find the dfp div/iframe on each DOM mutation
    mutationObserver = new MutationObserver(() => {
      if (tryFindTarget()) {
	    console.log('ADH found dfp div/iframe on DOM mutation ');	
        mutationObserver.disconnect();
      }
    });

    mutationObserver.observe(document.documentElement, {
      childList: true,
      subtree: true
    });

    // Safety timeout
    setTimeout(() => finish(lastHeight), timeoutMs);
  });
}



function initAdInfo() {
	
	if (Math.random() > 0.10 && !window.location.href.includes('forceAdHeightTrack')) {
		console.log("ADH","bail 0");
		return;
	}
			
			
	if (screen.orientation?.type) {
		if (window.innerWidth > window.innerHeight) {
			console.log("ADH", 'landscape - bailing out');
			return;
		}
	}
						
	
	window.googletag = window.googletag || {};
	googletag.cmd = googletag.cmd || [];

	window.adInfo = window.adInfo || {};

	console.log("ADH", '[adInfo] adding to googletag.cmd queue');

	googletag.cmd.push(() => {
		const pubads = googletag.pubads?.();
		if (!pubads) {
			console.log("ADH", '[adInfo] googletag.pubads not available');
			return;
		}

		console.log("ADH", '[adInfo] adding "slotRenderEnded" listener');

		pubads.addEventListener('slotRenderEnded', (event) => {

			const slot = event.slot;
			
			//console.log("ADH", '[adInfo] slot id rendered',slot.getSlotId(),slot.getSlotElementId());
			
			const slotId = slot?.getSlotElementId();
			if (!slotId) {
				console.log("ADH","bail 1",slot);
				return;
			}
	
			if (slotId !== 'directTag') return; 

			if (window.a360_ad_size_recorded && window.a360_ad_size_recorded[slotId]) {
				console.log('ADH','A2 slot '+slotId+' already logged, skipping');
				return;
			}

			// Non-blocking logging
			setTimeout(() => {

				const slotEl = document.getElementById(slotId);
				if (!slotEl) {
					console.log("ADH", '[adInfo] no slot element ', slotId);
					return;
				}

				const iframe = slotEl.querySelector('iframe');
				if (!iframe) {
					console.log("ADH", '[adInfo] no frame ', slotId);
					return;
				}

				console.log("ADH", 'before requestAnimationFrame ', slotId);
				requestAnimationFrame(() => {
					console.log("ADH", 'after requestAnimationFrame ', slotId, slot);
					waitForFinalHeightFromDirectTag({
  					   stableForMs: 800,
 					   timeoutMs: 6000
					}).then(height => {
   							 console.log('ADH final height', height);
   							 if (Number.isFinite(height) && height > 90 && height < 600) {
								console.log(
									'ADH Actual rendered size',
									slotId,
									'height:',
									height
								);

								const args = {
									event: 'recordHeight',
									slotId: slotId,
									height: height,
									path: window.location.pathname,
									ts: Date.now()
								};

								collectAdSize(args);
						
							} else {
								console.log("ADH", 'bad height  ',height, slotId);
							}
 						 })
 						 .catch((err) => {
  							  console.log('ADH measurement failed', err);
  						 });		
				});

			}, 0);
		});
	});
}


