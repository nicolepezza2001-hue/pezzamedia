function collectBrowserDebugInfo() {

	function isMobile() {
      return /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  }

  // --- Browser name + version ---
  function getBrowserInfo() {
    const ua = navigator.userAgent;

    let name = "Unknown";
    let version = "Unknown";

    if (/Chrome/.test(ua) && !/Edge/.test(ua) && !/OPR/.test(ua)) {
      name = "Chrome";
      version = ua.match(/Chrome\/([0-9.]+)/)?.[1];
    } else if (/Firefox/.test(ua)) {
      name = "Firefox";
      version = ua.match(/Firefox\/([0-9.]+)/)?.[1];
    } else if (/Safari/.test(ua) && !/Chrome/.test(ua)) {
      name = "Safari";
      version = ua.match(/Version\/([0-9.]+)/)?.[1];
    } else if (/Edg/.test(ua)) {
      name = "Edge";
      version = ua.match(/Edg\/([0-9.]+)/)?.[1];
    }

    return { name, version };
  }




  // --- Extract isCommerce from dataLayer ---
  function getIsCommerce() {
    try {
      if (!Array.isArray(window.dataLayer)) return "off";

      for (const item of window.dataLayer) {
        if (typeof item === "object" && item.isCommerce !== undefined) {
          return item.isCommerce;
        }
      }

      return "off";
    } catch (e) {
      return "off";
    }
  }

  const browser = getBrowserInfo();

  return {
    browser: browser.name,
    browserVersion: browser.version,
    platformOS: navigator.platform || "unknown",
    pageURL: location.href,
    pageReferrer: document.referrer || null,
    inIframe: window.self !== window.top,
    isCommerce: getIsCommerce(),
  	ts: Date.now(),
		isMobile:isMobile()
  };
}


