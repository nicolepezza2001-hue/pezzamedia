function collectA360PerformanceMetrics(prefix = "wv_") {
	var result = {};
	let perf = getPerfDimenstions();
	let bytes = getBandwidthDimensions();

	let summary = { ...perf, ...bytes };

	for (let prop in summary) {
		if (summary.hasOwnProperty(prop)) {
			result[prefix + prop] = summary[prop];
		}
	}
	return result;
}

function getPerfDimenstions() {
	try {
		const resources = performance.getEntriesByType("resource") || [];

		function getApexDomain(url) {
			try {
				const hostname = new URL(url).hostname;
				const parts = hostname.split('.');
				return parts.length >= 2 ? parts.slice(-2).join('.') : hostname;
			} catch {
				return 'invalid';
			}
		}

		const buckets = {
			'500-1000': [], '1000-2000': [], '2000-3000': [],
			'3000-4000': [], '4000+': []
		};

		const scriptResources = resources.filter(r => r.initiatorType === 'script');

		for (const r of scriptResources) {
			const d = r.duration;
			const domain = getApexDomain(r.name);

			if (d >= 500 && d < 1000) buckets['500-1000'].push(domain);
			else if (d < 2000) buckets['1000-2000'].push(domain);
			else if (d < 3000) buckets['2000-3000'].push(domain);
			else if (d < 4000) buckets['3000-4000'].push(domain);
			else buckets['4000+'].push(domain);
		}

		const uniq = arr => [...new Set(arr)].sort().join('|');

		return {
			performance_1s: uniq(buckets['500-1000']),
			performance_2s: uniq(buckets['1000-2000']),
			performance_3s: uniq(buckets['2000-3000']),
			performance_4s: uniq(buckets['3000-4000']),
			performance_5s: uniq(buckets['4000+']),
		};

	} catch {
		return {};
	}
}

function getBandwidthDimensions() {
	try {
		const resources = performance.getEntriesByType("resource") || [];

		function getApexDomain(url) {
			try {
				const hostname = new URL(url).hostname;
				const parts = hostname.split('.');
				return parts.length >= 2 ? parts.slice(-2).join('.') : hostname;
			} catch {
				return 'invalid';
			}
		}

		const buckets = {
			'50-100KB': [], '100-200KB': [], '200-300KB': [],
			'300-400KB': [], '400KB+': []
		};

		const scriptResources = resources.filter(r => r.initiatorType === 'script');

		for (const r of scriptResources) {
			const sizeKB = (r.transferSize || 0) / 1024;
			const domain = getApexDomain(r.name);

			if (sizeKB < 100) buckets['50-100KB'].push(domain);
			else if (sizeKB < 200) buckets['100-200KB'].push(domain);
			else if (sizeKB < 300) buckets['200-300KB'].push(domain);
			else if (sizeKB < 400) buckets['300-400KB'].push(domain);
			else buckets['400KB+'].push(domain);
		}

		const uniq = arr => [...new Set(arr)].sort().join('|');

		return {
			bandwidth_100k: uniq(buckets['50-100KB']),
			bandwidth_200k: uniq(buckets['100-200KB']),
			bandwidth_300k: uniq(buckets['200-300KB']),
			bandwidth_400k: uniq(buckets['400KB+']),
			bandwidth_500k: uniq(buckets['400KB+']),
		};

	} catch {
		return {};
	}
}

