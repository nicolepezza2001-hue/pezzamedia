				<label for="passwordReset" class="screen-reader-only">Enter new password</label>
				<div class="password-input-wrapper">
					<input type="password" class="form-control js-validate-password js-password" id="passwordReset" placeholder="Enter Password" pattern=".*" required aria-label="Password" aria-describedby="pass-error_login-forgot">
					<i class="view-password-button" tabindex="0" aria-live="assertive" role="button" name="Show or hide password" aria-pressed="false" onclick="inline.utility.showPassword( 'reset' )"></i>
					<span class="error-message error-message__password" id="pass-error_login-forgot" aria-live="assertive" role="alert"></span>
